{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlcenter.krishraja.com/schemas/engine-report-1.0.0.json",
  "title": "Growth engine report, protocol 1.0.0 to 1.2.0 and 1.20.0 (ADR-038), as this engine speaks it",
  "$comment": "A partial copy of Control Center docs/app/growth/engine-report.schema.json (krishanraja/control-center main 14379de, 2026-11-11): the 1.0.0 to 1.2.0 fields, and the 1.20.0 engine state copied verbatim. Versions 1.3.0 to 1.19.0 add fields this engine never sends and are left out. Checked again against main 0728c9aa on 2026-11-12: the 1.20.0 fields are unchanged there, and 1.21.0 adds only growth-makeyourmindup's inspiration_used, also left out. Control Center's copy is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_id",
    "product_slug",
    "run_id",
    "mode",
    "observed_at",
    "source",
    "status",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.20.0"
      ],
      "description": "1.1.0 adds a proposal's stage and parent_proposal_id, 1.2.0 its subject_ref; an older report carrying a newer field is refused. 1.20.0 adds priorities, obsessions, next_steps and instruction_acks, the engine state on every place in Control Center and what it did with Krish's instruction, each refused before 1.20.0; send them only when the directive says features.engine_state."
    },
    "engine_id": {
      "type": "string",
      "maxLength": 64
    },
    "product_slug": {
      "type": "string",
      "maxLength": 64
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,119}$"
    },
    "mode": {
      "enum": [
        "live",
        "synthetic"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "revision",
        "captured_at"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "maxLength": 128
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "enum": [
        "ready",
        "held",
        "degraded"
      ]
    },
    "objectives": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "unit",
          "availability"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "window_start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "window_end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "availability": {
            "enum": [
              "measured",
              "missing",
              "stale"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "activity": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "line"
        ],
        "properties": {
          "line": {
            "type": "string",
            "maxLength": 500
          },
          "evidence_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://\\S+$"
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "title",
          "why",
          "kind",
          "wall",
          "payload_sha256",
          "close_condition"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,119}$"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "why": {
            "type": "string",
            "maxLength": 1000
          },
          "kind": {
            "enum": [
              "advice",
              "prepared",
              "autonomous"
            ]
          },
          "wall": {
            "enum": [
              "none",
              "spend",
              "send",
              "post",
              "strategy"
            ]
          },
          "amount_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "channel": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "objective_key": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "exact_payload": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 8000
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 500
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^https://\\S+$"
                }
              }
            }
          },
          "close_condition": {
            "type": "object",
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "stage": {
            "enum": [
              "plan",
              "go_live",
              "check_in",
              null
            ],
            "description": "1.1.0. An autonomous engine's plan (behind a wall, waiting on his yes), its go-live (send, post or spend) for his review, or a check-in (a strategy call naming its plan, with its progress in exact_payload)."
          },
          "parent_proposal_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "1.1.0. The plan a go-live carries out. Required on a go-live."
          },
          "subject_ref": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(contact|target|event):[A-Za-z0-9_-]{1,64}$",
            "description": "1.2.0. The person, stage or room the proposal is about, by the id Control Center gave the engine. His list keeps Control Center's own copy of the same subject instead."
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "event",
          "at"
        ],
        "properties": {
          "event": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "proposal_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://\\S+$"
          }
        }
      }
    },
    "holds": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "priorities": {
      "type": "array",
      "maxItems": 5,
      "description": "1.20.0, optional (directive features.engine_state): what the engine is chasing, most important first. One plain line each, with no address or phone number. Shown on every place in Control Center as reported, never inferred.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "line"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "objective_key": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "description": "The objective it serves, or null."
          }
        }
      }
    },
    "obsessions": {
      "type": "array",
      "maxItems": 3,
      "description": "1.20.0, optional: Krish's own aims the engine will not let go of, quoted from its own docs as lines, never invented.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line"
        ],
        "properties": {
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "since": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "maxItems": 5,
      "description": "1.20.0, optional: what the engine does next, and who each step waits on.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "waits_on"
        ],
        "properties": {
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "waits_on": {
            "enum": [
              "engine",
              "krish",
              "other"
            ]
          },
          "when": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "instruction_acks": {
      "type": "array",
      "maxItems": 5,
      "description": "1.20.0, optional, applied from live reports only: what the engine did with each instruction of Krish's it read (the directive's krish_instruction), by id only. A line says what it did, or why it is blocked and what would unblock it, and never quotes his words: engine repositories and their Actions logs are public. Forward only: received, then started or blocked, then done; nothing after done.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction_id",
          "state",
          "line",
          "at"
        ],
        "properties": {
          "instruction_id": {
            "type": "string",
            "pattern": "^ki_[0-9a-f]{24}$"
          },
          "state": {
            "enum": [
              "received",
              "started",
              "done",
              "blocked"
            ]
          },
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://\\S+$"
          }
        }
      }
    }
  }
}
